{
  "paths": {
    "/v1/employee/shifts": {
      "get": {
        "responses": {
          "200": {
            "description": "Successful response verified against captured browser traffic",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShiftListResponse" }
              }
            }
          }
        },
        "x-confirmation": "retrofit-annotation+har-response"
      }
    },
    "/v1/staff/shift/schedule": {
      "get": {
        "responses": {
          "404": {
            "description": "No active staff employment contract",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OzonJobError" }
              }
            }
          }
        },
        "x-confirmation": "retrofit-annotation+har-error-response"
      }
    },
    "/v1/calendar/object/{id}/process/{processId}": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CalendarRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calendar response verified against browser traffic",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CalendarResponse" }
              }
            }
          }
        },
        "x-confirmation": "retrofit-annotation+browser-response"
      }
    },
    "/v1/calendar/object/{id}/process/{processId}/slots": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SelectedScheduleRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Available time slots verified against browser traffic",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShiftTimeSlotsResponse" }
              }
            }
          }
        },
        "x-confirmation": "retrofit-annotation+browser-response"
      }
    }
  },
  "components": {
    "schemas": {
      "ShiftListResponse": {
        "type": "object",
        "description": "Shape verified from a successful browser HAR capture on 2026-08-10.",
        "required": ["approveBookBeforeHours", "shifts", "staffShifts"],
        "properties": {
          "approveBookBeforeHours": { "type": "integer" },
          "shifts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/EmployeeShift" }
          },
          "staffShifts": { "type": ["object", "null"] }
        }
      },
      "EmployeeShift": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "canBeCancelled": { "type": "boolean" },
          "isNight": { "type": "boolean" },
          "probability": { "type": "string" },
          "shiftCreator": { "type": "string" },
          "state": { "type": "string" },
          "interval": {
            "type": "object",
            "properties": {
              "startTime": { "type": "string", "format": "date-time" },
              "endTime": { "type": "string", "format": "date-time" }
            }
          },
          "object": { "$ref": "#/components/schemas/ShiftObject" },
          "process": { "$ref": "#/components/schemas/ShiftProcess" },
          "transportation": { "$ref": "#/components/schemas/ShiftTransportation" }
        }
      },
      "ShiftObject": {
        "type": "object",
        "properties": {
          "details": {
            "type": "object",
            "properties": {
              "landingPageUrl": { "type": "string", "format": "uri" },
              "objectInstructionUrl": { "type": "string", "format": "uri" }
            }
          },
          "requirements": {
            "type": "object",
            "properties": {
              "bus": { "type": "boolean" },
              "uniform": { "type": "boolean" }
            }
          },
          "warehouse": { "$ref": "#/components/schemas/Warehouse" }
        }
      },
      "Warehouse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "address": { "type": "string" },
          "cooldownPeriod": { "type": "string" },
          "timezone": { "type": "string" },
          "type": { "type": "string" },
          "coordinates": {
            "type": "object",
            "properties": {
              "latitude": { "type": "string" },
              "longitude": { "type": "string" }
            }
          }
        }
      },
      "ShiftProcess": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "payment": {
            "type": "object",
            "properties": {
              "changePercent": { "type": "string" },
              "period": { "type": "integer" },
              "rate": { "type": "string" },
              "ratePerHour": { "type": "string" },
              "boosted": { "type": "boolean" }
            }
          },
          "isLearning": { "type": "boolean" },
          "vacancy": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" }
            }
          }
        }
      },
      "ShiftTransportation": {
        "type": "object",
        "properties": {
          "busStop": { "type": "string" },
          "name": { "type": "string" },
          "needReclarify": { "type": "boolean" },
          "type": { "type": "string" }
        }
      },
      "OzonJobError": {
        "type": "object",
        "description": "Error shape verified from browser HAR traffic on 2026-08-10; identifying message content was not retained.",
        "required": ["code", "message", "details"],
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "details": {
            "type": "array",
            "items": {}
          }
        }
      },
      "CalendarDate": {
        "type": "object",
        "required": ["year", "month", "day"],
        "properties": {
          "year": { "type": "integer" },
          "month": { "type": "integer", "minimum": 1, "maximum": 12 },
          "day": { "type": "integer", "minimum": 1, "maximum": 31 }
        }
      },
      "CalendarRequest": {
        "type": "object",
        "required": ["date"],
        "properties": {
          "date": { "$ref": "#/components/schemas/CalendarDate" }
        }
      },
      "CalendarResponse": {
        "type": "object",
        "description": "Shape verified from a successful browser request on 2026-08-10.",
        "required": ["warehouse", "process", "days", "transportation", "titleComponentId", "banners", "profilePhotoStatus", "schedules", "requirements"],
        "properties": {
          "warehouse": { "$ref": "#/components/schemas/Warehouse" },
          "process": { "$ref": "#/components/schemas/ShiftProcess" },
          "days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CalendarDay" }
          },
          "transportation": { "$ref": "#/components/schemas/ShiftTransportation" },
          "titleComponentId": { "type": "string" },
          "banners": { "type": "array", "items": {} },
          "profilePhotoStatus": { "type": "string" },
          "schedules": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CalendarSchedule" }
          },
          "requirements": { "$ref": "#/components/schemas/CalendarRequirements" }
        }
      },
      "CalendarDay": {
        "type": "object",
        "required": ["day", "badges", "probability"],
        "properties": {
          "day": { "$ref": "#/components/schemas/CalendarDate" },
          "badges": { "type": "array", "items": { "type": "string" } },
          "probability": { "type": "string" }
        }
      },
      "CalendarSchedule": {
        "type": "object",
        "required": ["id", "type", "scheduleName", "standardScheduleConfig", "constraints"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "scheduleName": { "type": "string" },
          "standardScheduleConfig": {
            "oneOf": [
              { "$ref": "#/components/schemas/StandardScheduleConfig" },
              { "type": "null" }
            ]
          },
          "constraints": { "$ref": "#/components/schemas/CalendarScheduleConstraints" }
        }
      },
      "StandardScheduleConfig": {
        "type": "object",
        "required": ["daysToWork", "daysToRest"],
        "properties": {
          "daysToWork": { "type": "integer" },
          "daysToRest": { "type": "integer" }
        }
      },
      "CalendarScheduleConstraints": {
        "type": "object",
        "required": ["minStartDate", "maxStartDate", "minDaysCount", "maxEndDate", "allowDayCut", "maxPossibleRange"],
        "properties": {
          "minStartDate": { "type": ["string", "null"] },
          "maxStartDate": { "type": ["string", "null"] },
          "minDaysCount": { "type": ["integer", "null"] },
          "maxEndDate": { "type": ["string", "null"] },
          "allowDayCut": { "type": "boolean" },
          "maxPossibleRange": { "type": "integer" }
        }
      },
      "CalendarRequirements": {
        "type": "object",
        "required": ["medicalBook", "uniform", "bus"],
        "properties": {
          "medicalBook": { "type": "boolean" },
          "uniform": { "type": "boolean" },
          "bus": { "type": "boolean" }
        }
      },
      "SelectedScheduleRequest": {
        "type": "object",
        "required": ["selectedScheduleConfig"],
        "properties": {
          "selectedScheduleConfig": { "$ref": "#/components/schemas/SelectedScheduleConfigRequest" }
        }
      },
      "SelectedScheduleConfigRequest": {
        "type": "object",
        "required": ["chosenDays", "scheduleId", "startDate"],
        "properties": {
          "chosenDays": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CalendarDate" }
          },
          "scheduleId": { "type": "string" },
          "startDate": { "$ref": "#/components/schemas/CalendarDate" }
        }
      },
      "ShiftTimeSlotsResponse": {
        "type": "object",
        "description": "Shape verified from a successful browser request on 2026-08-10.",
        "required": ["warehouse", "process", "groupedSlots", "profilePhotoStatus", "constraints"],
        "properties": {
          "warehouse": { "$ref": "#/components/schemas/Warehouse" },
          "process": { "$ref": "#/components/schemas/ShiftProcess" },
          "groupedSlots": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GroupedShiftSlots" }
          },
          "profilePhotoStatus": { "type": "string" },
          "constraints": {}
        }
      },
      "GroupedShiftSlots": {
        "type": "object",
        "required": ["duration", "confirmIntervals", "queueIntervals"],
        "properties": {
          "duration": { "type": "integer" },
          "confirmIntervals": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AvailableShiftInterval" }
          },
          "queueIntervals": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AvailableShiftInterval" }
          }
        }
      },
      "AvailableShiftInterval": {
        "type": "object",
        "required": ["interval", "payment", "badges", "totalRate"],
        "properties": {
          "interval": { "$ref": "#/components/schemas/ShiftInterval" },
          "payment": { "$ref": "#/components/schemas/ShiftPayment" },
          "badges": { "type": "array", "items": { "type": "string" } },
          "totalRate": { "type": "string" }
        }
      },
      "ShiftInterval": {
        "type": "object",
        "required": ["startTime", "endTime"],
        "properties": {
          "startTime": { "type": "string", "format": "date-time" },
          "endTime": { "type": "string", "format": "date-time" }
        }
      },
      "ShiftPayment": {
        "type": "object",
        "required": ["rate", "period", "boosted", "changePercent", "ratePerHour"],
        "properties": {
          "rate": { "type": "string" },
          "period": { "type": "integer" },
          "boosted": { "type": "boolean" },
          "changePercent": { "type": "string" },
          "ratePerHour": { "type": "string" }
        }
      }
    }
  }
}
